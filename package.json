{
  "name": "dsh-telegram-plus",
  "version": "0.1.1",
  "description": "Telegram notifications for DeepSeek Harness with Telegram-native formatting, plus two-way answers to pending questions and tool approvals from the chat.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "release": "npm test && npm publish --access public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "cordis",
    "telegram",
    "telegram-bot",
    "notifications",
    "notify",
    "push-notification",
    "approval",
    "approvals",
    "questions",
    "html",
    "markdown",
    "remote",
    "通知",
    "提醒",
    "审批提醒",
    "机器人"
  ],
  "license": "MIT",
  "author": "5alex52",
  "contributors": [
    "Rúben Garrido <https://github.com/RGarrido03> (upstream dsh-telegram-notify)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5alex52/dsh-telegram-plus.git"
  },
  "homepage": "https://github.com/5alex52/dsh-telegram-plus#readme",
  "bugs": {
    "url": "https://github.com/5alex52/dsh-telegram-plus/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
